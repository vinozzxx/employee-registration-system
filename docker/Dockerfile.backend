# -------------------------------------------------------
# Backend Dockerfile — Multi-stage build
# Stage 1 (builder): Compile TypeScript
# Stage 2 (runner):  Production image with only compiled JS
# -------------------------------------------------------

# Stage 1 — Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests first (Docker layer cache optimization)
COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci --only=production=false

# Copy source and compile
COPY . .
RUN npm run prisma:generate
RUN npm run build

# -------------------------------------------------------
# Stage 2 — Production runner (minimal image)
# -------------------------------------------------------
FROM node:22-alpine AS runner

RUN apk add --no-cache dumb-init

WORKDIR /app

ENV NODE_ENV=production

# Copy only production dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy compiled output and Prisma client
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY prisma ./prisma/

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 express

USER express

EXPOSE 5000

# dumb-init handles signal forwarding (graceful shutdown)
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/server.js"]
