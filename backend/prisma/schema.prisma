// Prisma Schema — Employee Registration Management System
// Reference: docs/PROJECT_BLUEPRINT.md — Section: Database Design
//
// Phase 2: User model + Registration model + relationships + indexes + migration.
//
// Naming conventions (AGENT_RULES.md + PROJECT_BLUEPRINT.md):
//   - Table names:  snake_case  (@@map)
//   - Column names: snake_case  (@map)
//   - Model names:  PascalCase  (Prisma convention)
//   - Field names:  camelCase   (TypeScript convention)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// USER MODEL
// Represents an admin/HR user who can log in and manage registrations.
// Reference: PROJECT_BLUEPRINT.md → "2. Users Table"
// -------------------------------------------------------
model User {
  // Primary key — UUID v4, auto-generated by the database.
  // UUID over auto-increment: safe to expose in URLs, no sequential enumeration attack.
  id String @id @default(uuid()) @db.Uuid

  // Full display name of the user.
  // NOT NULL — every account must have an identity.
  name String @db.VarChar(100)

  // Login email — must be unique across all users.
  // VARCHAR(255) follows RFC 5321 SMTP limit.
  // UNIQUE constraint prevents duplicate registrations for the same email.
  email String @unique @db.VarChar(255)

  // bcrypt-hashed password.
  // TEXT (no length limit) because bcrypt hash is always 60 chars,
  // but TEXT gives flexibility if the algorithm changes in future.
  // Stored as `password_hash` in DB — the "hash" suffix makes it obvious
  // this column never contains plaintext.
  passwordHash String @map("password_hash") @db.Text

  // Audit timestamp — set once on INSERT, never updated.
  // @default(now()) = database-level NOW() so it's always accurate
  // regardless of application server timezone.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Audit timestamp — updated automatically by Prisma on every UPDATE.
  // @updatedAt is a Prisma directive — it sets the field to NOW() on every update.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relation: one user owns zero or more employees.
  // This field does NOT create a column — it is a Prisma virtual relation field.
  employees Employee[]

  // Explicit index on email for fast login lookups.
  // Even though email is UNIQUE (which implicitly creates an index),
  // declaring it explicitly in @@index documents the intent.
  @@index([email])
  // Maps this Prisma model to the "users" table in PostgreSQL.
  @@map("users")
}

// -------------------------------------------------------
// EMPLOYEE MODEL
// Represents an employee registration record created by a User.
// -------------------------------------------------------
model Employee {
  // Primary key — UUID v4, auto-generated.
  id String @id @default(uuid()) @db.Uuid

  // Employee details
  firstName String  @map("first_name") @db.VarChar(50)
  lastName  String? @map("last_name") @db.VarChar(50)

  // Employee contact email.
  email String @db.VarChar(255)

  // Contact number
  contact String @db.VarChar(20)

  // Gender
  gender String @db.VarChar(20)

  // New Demographic fields
  department  String   @db.VarChar(100)
  designation String   @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  address     String   @db.Text
  city        String   @db.VarChar(100)
  state       String   @db.VarChar(100)
  country     String   @db.VarChar(100)
  postalCode  String   @map("postal_code") @db.VarChar(20)

  // Foreign key — which User created this registration.
  createdByUserId String @map("created_by_user_id") @db.Uuid

  // Audit fields
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Audit timestamp — set on INSERT.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Audit timestamp — updated on every UPDATE.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relation: belongs-to User.
  user User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  // Composite unique constraint: email must be unique per user.
  // This supports multi-tenancy logic (each user can have their own set of employees)
  @@unique([email, createdByUserId])
  // Indexes for robust search and pagination performance
  @@index([createdByUserId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([department])
  // Maps to the "employees" table in PostgreSQL.
  @@map("employees")
}
