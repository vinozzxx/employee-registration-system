# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -------------------------------------------------------
# Server
# -------------------------------------------------------
NODE_ENV=development
PORT=5000

# -------------------------------------------------------
# Database
# -------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_registration

# -------------------------------------------------------
# Authentication
# -------------------------------------------------------
# Must be at least 32 characters long. Use a strong random secret in production.
JWT_SECRET=change-this-to-a-secure-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# -------------------------------------------------------
# CORS
# -------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
